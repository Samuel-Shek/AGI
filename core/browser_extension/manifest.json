{
  "manifest_version": 3,
  "name": "AGI Browser Signals",
  "version": "0.9.1",
  "description": "Sends low-sensitivity browser context signals to the local AGI core.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["policy.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "incognito": "split"
}
